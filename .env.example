# Copier ce fichier en ".env" et renseigner les vraies valeurs.
# Ne JAMAIS committer le fichier ".env" réel (ajouter ".env" au .gitignore).

# Clé API Anthropic — requise pour le Claude Agent SDK / API
ANTHROPIC_API_KEY=

# Optionnel : autres providers ou services utilisés par les tools custom
# OPENAI_API_KEY=
# SERPAPI_KEY=
# DATABASE_URL=

# Optionnel : modèle par défaut si non défini dans le code
CLAUDE_MODEL=claude-sonnet-4-6
